    {
      "key": "enabled-sources",
      "name": "Enabled source configuration (wizard)",
      "description": "Latest observed configuration per installation within the selected window, not source use. Six fixed categories include zeros. Installations without a configuration-bearing event are absent.",
      "tags": [
        "wizard"
      ],
      "query": {
        "kind": "DataVisualizationNode",
        "display": "ActionsTable",
        "source": {
          "kind": "HogQLQuery",
          "query": "SELECT source, countIf(has(JSONExtract(enabled, 'Array(String)'), source)) AS enabled_installations, count() AS observed_installations FROM (SELECT distinct_id, argMax(properties.enabled_sources, timestamp) AS enabled FROM events WHERE properties.environment = 'production' AND {filters} AND properties.enabled_sources IS NOT NULL GROUP BY distinct_id) ARRAY JOIN ['spotify', 'appleMusic', 'youtubeMusic', 'zoom', 'teams', 'huddle'] AS source GROUP BY source ORDER BY source",
          "filters": {
            "dateRange": {
              "date_from": "-30d"
            },
            "filterTestAccounts": false
          }
        }
      }
    },
    {
      "key": "failure-frequency",
      "name": "Failure frequency by cause, component and version (wizard)",
      "description": "Sum of MAX cumulative occurrence_count per installation/environment/episode in the selected records. Recovery is local to an episode, not global issue resolution. Counts can include occurrences before the selected window.",
      "tags": [
        "wizard"
      ],
      "query": {
        "kind": "DataVisualizationNode",
        "display": "ActionsTable",
        "source": {
          "kind": "HogQLQuery",
          "query": "SELECT environment, component, step, code, app_version, sum(observed_occurrences) AS observed_occurrences, count() AS episodes, countIf(recovered) AS recovered_episodes FROM (SELECT distinct_id AS diagnostic_installation, properties.environment AS environment, properties.episode_id AS episode_id,\nargMax(properties.component, timestamp) AS component, argMax(properties.step, timestamp) AS step,\nargMax(properties.code, timestamp) AS code, argMax(properties.message, timestamp) AS message,\nargMax(properties.app_version, timestamp) AS app_version, argMax(properties.os_platform, timestamp) AS os_platform,\nargMax(properties.connection_ref, timestamp) AS connection_ref, argMax(properties.source, timestamp) AS source,\nargMax(properties.http_status, timestamp) AS http_status, argMax(properties.network_code, timestamp) AS network_code,\nargMax(properties.exit_code, timestamp) AS exit_code, argMax(properties.signal, timestamp) AS signal,\nargMax(properties.first_seen, timestamp) AS first_seen, argMax(properties.last_seen, timestamp) AS last_seen,\nargMax(properties.first_operation_id, timestamp) AS first_operation_id, argMax(properties.last_operation_id, timestamp) AS last_operation_id,\nargMax(properties.recovery_operation_id, timestamp) AS recovery_operation_id,\nmax(toInt(properties.occurrence_count)) AS observed_occurrences,\ncountIf(event = 'diagnostic_recovered') > 0 AS recovered,\nargMax(properties.$exception_issue_id, timestamp) AS native_issue_id\nFROM events WHERE properties.environment = 'production' AND {filters} AND event IN ('$exception', 'diagnostic_summary', 'diagnostic_recovered') AND properties.episode_id IS NOT NULL\nGROUP BY distinct_id, properties.environment, properties.episode_id) GROUP BY environment, component, step, code, app_version ORDER BY observed_occurrences DESC",
          "filters": {
