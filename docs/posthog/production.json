{
  "dashboard": {
    "name": "Analytics basics (wizard)",
    "description": "Production adoption, successful Shared Status delivery, setup and diagnostic episodes. Installation counts are not people; every query independently selects production.",
    "tags": [
      "wizard"
    ],
    "grid_spacing": "condensed"
  },
  "insights": [
    {
      "key": "activity",
      "name": "Active installations and successful use (wizard)",
      "description": "Daily distinct environment-namespaced installation IDs. Background activity and fully successful logical status operations are separate signals; neither counts people.",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "kind": "TrendsQuery",
          "series": [
            {
              "kind": "EventsNode",
              "event": "app_activity",
              "name": "Active installations",
              "math": "dau",
              "properties": [
                {
                  "key": "environment",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "production"
                  ]
                },
                {
                  "type": "hogql",
                  "key": "properties.environment = 'production'"
                }
              ]
            },
            {
              "kind": "EventsNode",
              "event": "status_operation",
              "name": "Installations with complete delivery",
              "math": "dau",
              "properties": [
                {
                  "key": "environment",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "production"
                  ]
                },
                {
                  "key": "outcome",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "success"
                  ]
                },
                {
                  "type": "hogql",
                  "key": "properties.environment = 'production'"
                }
              ]
            }
          ],
          "dateRange": {
            "date_from": "-30d"
          },
          "interval": "day",
          "filterTestAccounts": false,
          "trendsFilter": {
            "display": "ActionsLineGraph"
          }
        }
      },
      "tags": [
        "wizard"
      ]
    },
    {
      "key": "activity-return",
      "name": "Returning active installations (wizard)",
      "description": "Weekly recurring activity retention. Each cohort contains installations active that week; later columns require activity again. Incomplete future intervals are not churn.",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "kind": "RetentionQuery",
          "dateRange": {
            "date_from": "-8w"
          },
          "filterTestAccounts": false,
          "retentionFilter": {
            "targetEntity": {
              "id": "app_activity",
              "type": "events",
              "properties": [
                {
                  "key": "environment",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "production"
                  ]
                },
                {
                  "type": "hogql",
                  "key": "properties.environment = 'production'"
                }
              ]
            },
            "returningEntity": {
              "id": "app_activity",
              "type": "events",
              "properties": [
                {
                  "key": "environment",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "production"
                  ]
                },
                {
                  "type": "hogql",
                  "key": "properties.environment = 'production'"
                }
              ]
            },
            "retentionType": "retention_recurring",
            "period": "Week",
            "totalIntervals": 8,
            "cumulative": false,
            "timeWindowMode": "strict_calendar_dates"
          }
        }
      },
      "tags": [
        "wizard"
      ]
    },
    {
      "key": "use-return",
      "name": "Returning successful use (wizard)",
      "description": "Weekly recurring retention of fully successful status operations. Partial, failed and skipped operations do not count as delivered value.",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "kind": "RetentionQuery",
          "dateRange": {
            "date_from": "-8w"
          },
          "filterTestAccounts": false,
          "retentionFilter": {
            "targetEntity": {
              "id": "status_operation",
              "type": "events",
              "properties": [
                {
                  "key": "environment",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "production"
                  ]
                },
                {
                  "key": "outcome",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "success"
                  ]
                },
                {
                  "type": "hogql",
                  "key": "properties.environment = 'production'"
                }
              ]
            },
            "returningEntity": {
              "id": "status_operation",
              "type": "events",
              "properties": [
                {
                  "key": "environment",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "production"
                  ]
                },
                {
                  "key": "outcome",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "success"
                  ]
                },
                {
                  "type": "hogql",
                  "key": "properties.environment = 'production'"
                }
              ]
            },
            "retentionType": "retention_recurring",
            "period": "Week",
            "totalIntervals": 8,
            "cumulative": false,
            "timeWindowMode": "strict_calendar_dates"
          }
        }
      },
      "tags": [
        "wizard"
      ]
    },
    {
      "key": "activation",
      "name": "New setup to successful use (wizard)",
      "description": "Installation-level ordered funnel within 14 days: setup start, successful setup with replaced_existing=false, then a fully successful status operation. This is first subsequent observed use, not a first-ever-person claim; multiple attempts/workspaces can belong to one installation.",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "kind": "FunnelsQuery",
          "dateRange": {
            "date_from": "-30d"
          },
          "filterTestAccounts": false,
          "series": [
            {
              "kind": "EventsNode",
              "event": "connection_started",
              "math": "total",
              "properties": [
                {
                  "key": "environment",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "production"
                  ]
                },
                {
                  "key": "flow",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "setup"
                  ]
                },
                {
                  "type": "hogql",
                  "key": "properties.environment = 'production'"
                }
              ],
              "custom_name": "Setup started"
            },
            {
              "kind": "EventsNode",
              "event": "connection_completed",
              "math": "total",
              "properties": [
                {
                  "key": "environment",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "production"
                  ]
                },
                {
                  "key": "flow",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "setup"
                  ]
                },
                {
                  "key": "outcome",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "success"
                  ]
                },
                {
                  "key": "replaced_existing",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "false"
                  ]
                },
                {
                  "type": "hogql",
                  "key": "properties.environment = 'production'"
                }
              ],
              "custom_name": "New connection saved"
            },
            {
              "kind": "EventsNode",
              "event": "status_operation",
              "math": "total",
              "properties": [
                {
                  "key": "environment",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "production"
                  ]
                },
                {
                  "key": "outcome",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "success"
                  ]
                },
                {
                  "type": "hogql",
                  "key": "properties.environment = 'production'"
                }
              ],
              "custom_name": "First subsequent complete delivery"
            }
          ],
          "funnelsFilter": {
            "funnelVizType": "steps",
            "funnelOrderType": "ordered",
            "funnelWindowInterval": 14,
            "funnelWindowIntervalUnit": "day"
          }
        }
      },
      "tags": [
        "wizard"
      ]
    },
