{
  "name": "slack-status-bot",
  "version": "1.3.1",
  "description": "Cross-platform Slack Status Bot with Tray UI",
  "main": "public/electron.js",
  "homepage": "./",
  "author": "Martin",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-dev\"",
    "react-start": "cross-env BROWSER=none react-scripts start",
    "react-build": "react-scripts build",
    "tsc": "tsc",
    "electron-dev": "cross-env NODE_ENV=development ELECTRON_START_URL=http://localhost:3000 electron .",
    "electron-build": "npm run react-build && npm run tsc && electron-builder",
    "build": "npm run react-build && npm run tsc && npm run electron-build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-is-dev": "^3.0.1",
    "electron-updater": "^6.7.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^6.1.0",
    "@electron-forge/maker-deb": "^6.1.0",
    "@electron-forge/maker-rpm": "^6.1.0",
    "@electron-forge/maker-squirrel": "^6.1.0",
    "@electron-forge/maker-zip": "^6.1.0",
    "@electron-forge/plugin-webpack": "^6.1.0",
    "@jest/globals": "^29.7.0",
    "@jest/test-sequencer": "^29.7.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@types/electron": "^1.6.10",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.0",
    "react-scripts": "5.0.1",
    "ts-jest": "^29.1.1",
    "typescript": "^4.9.5",
    "vitest": "^1.0.0",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.slack-status-bot.app",
    "productName": "Slack Status Bot",
    "files": [
      "build/**/*",
      "dist/**/*.js",
      "public/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/axios/**/*",
      "node_modules/electron-is-dev/**/*",
      "node_modules/electron-updater/**/*"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://gitlab.com/api/v4/projects/wihel_de%2Fslack-status-bot-custom/releases"
      }
    ],
    "asar": false,
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
