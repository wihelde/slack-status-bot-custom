{
  "name": "slack-status-bot",
  "version": "2.3.1",
  "description": "Cross-platform Slack Status Bot with Tray UI",
  "main": "dist/electron.js",
  "homepage": "./",
  "author": {
    "name": "Martin",
    "email": "slack-status-bot@wihel.de"
  },
  "license": "MIT",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "concurrently \"npm run react-start\" \"npm run host:watch\" \"wait-on http://localhost:3000 dist/electron.js && npm run electron-dev\"",
    "react-start": "vite --host 127.0.0.1 --port 3000",
    "react-build": "vite build",
    "tsc": "tsc",
    "host:build": "tsc -p tsconfig.json",
    "host:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "host:smoke": "npm run host:build && node ./scripts/verify-electron-host-build.mjs",
    "smoke": "npm run electron:smoke",
    "electron:smoke": "npm run react-build && npm run host:build && node ./scripts/smoke-electron-renderer.mjs",
    "electron-dev": "cross-env NODE_ENV=development ELECTRON_START_URL=http://localhost:3000 electron .",
    "electron-build": "npm run react-build && npm run host:build && electron-builder && node ./scripts/verify-electron-package.mjs && npm run fix-dmg",
    "fix-dmg": "DMG=\"dist/Slack Status Bot-$(node -p \"require('./package.json').version\")-arm64.dmg\" && [ -f \"$DMG\" ] && ./scripts/fix-dmg-hidden-files.sh \"$DMG\" || true",
    "build": "npm run electron-build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-updater": "^6.7.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^42.11.3",
    "electron-builder": "^26.5.0",
    "jsdom": "^29.1.1",
    "typescript": "^4.9.5",
    "vite": "^8.3.0",
    "vitest": "^4.0.17",
    "wait-on": "^7.0.1"
  },
  "build": {
    "extends": null,
    "appId": "com.slack-status-bot.app",
    "productName": "Slack Status Bot",
    "extraMetadata": {
      "main": "dist/electron.js"
    },
    "files": [
      "build/**/*",
      "dist/**/*.js",
      "assets/**/*",
      "package.json",
      "node_modules/axios/**/*",
      "node_modules/electron-updater/**/*"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://gitlab.com/wihel_de/slack-status-bot-custom/-/raw/v${version}/app/dist"
    },
    "protocols": [
      {
        "name": "Slack Status Bot External Status Command",
        "schemes": [
          "slack-status-bot"
        ]
      }
    ],
    "asar": true,
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "Slack Status Bot",
      "background": "build-assets/dmg-background.png",
      "window": {
        "width": 540,
        "height": 580
      },
      "contents": [
        {
          "x": 100,
          "y": 340,
          "type": "file"
        },
        {
          "x": 440,
          "y": 340,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "svgo": "^3.0.0",
    "postcss": "^8.4.31"
  }
}
