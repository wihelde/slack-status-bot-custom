  echo "zoom  12345 user  123u  IPv4 0x0      0t0  UDP 127.0.0.1:99"
fi

if [[ "${MOCK_IN_HUDDLE}" == "1" ]]; then
  echo "Slack 23456 user  456u  IPv4 0x0      0t0  UDP 127.0.0.1:54321"
fi

if [[ "${MOCK_IN_TEAMS}" == "1" ]]; then
  echo "MSTeams 34567 user  789u  IPv4 0x0  0t0  UDP 10.0.0.1:50010"
fi

exit 0




